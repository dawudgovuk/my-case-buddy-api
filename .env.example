# Server
HOST=0.0.0.0
PORT=1337

# Secrets (auto-generated in .env)
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database: Neon PostgreSQL Configuration
# Set DATABASE_CLIENT to postgres to connect to Neon PostgreSQL
DATABASE_CLIENT=postgres
# Direct Neon connection string (Copy from Neon Console):
# e.g. postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Alternatively, configure via discrete fields:
DATABASE_HOST=ep-sample-pooler.eu-central-1.aws.neon.tech
DATABASE_PORT=5432
DATABASE_NAME=neondb
DATABASE_USERNAME=user
DATABASE_PASSWORD=password
DATABASE_SCHEMA=public

# Clerk Authentication & Subscription Handling
# Set your Clerk Secret & Publishable keys from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_ISSUER=https://...clerk.accounts.dev
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
