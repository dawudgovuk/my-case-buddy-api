{
  "kind": "collectionType",
  "collectionName": "parties",
  "info": {
    "singularName": "party",
    "pluralName": "parties",
    "displayName": "Party",
    "description": "Parties and children involved in court cases"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "role": {
      "type": "enumeration",
      "enum": [
        "Applicant",
        "Respondent",
        "Child",
        "Guardian",
        "Intervener"
      ],
      "required": true
    },
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "dateOfBirth": {
      "type": "date"
    },
    "address": {
      "type": "text"
    },
    "solicitorFirm": {
      "type": "string"
    },
    "solicitorContact": {
      "type": "string"
    },
    "contactEmail": {
      "type": "email"
    },
    "contactPhone": {
      "type": "string"
    },
    "representation": {
      "type": "string"
    },
    "parentalResponsibility": {
      "type": "boolean"
    },
    "schoolOrNursery": {
      "type": "string"
    },
    "specialMeasuresRequired": {
      "type": "string"
    },
    "case": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::case.case",
      "inversedBy": "parties"
    }
  }
}
