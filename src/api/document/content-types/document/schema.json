{
  "kind": "collectionType",
  "collectionName": "documents",
  "info": {
    "singularName": "document",
    "pluralName": "documents",
    "displayName": "Case Document",
    "description": "Case documents, bundles, and statements"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "Application",
        "Statement",
        "Medical",
        "Expert Report",
        "Bundle",
        "Order",
        "Other"
      ],
      "required": true
    },
    "uploadedAt": {
      "type": "datetime"
    },
    "url": {
      "type": "string",
      "required": true
    },
    "notes": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "fileName": {
      "type": "string"
    },
    "fileSize": {
      "type": "integer"
    },
    "mimeType": {
      "type": "string"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Draft",
        "Filed",
        "Served"
      ],
      "default": "Draft"
    },
    "pageCount": {
      "type": "integer"
    },
    "exhibitRef": {
      "type": "string"
    },
    "case": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::case.case",
      "inversedBy": "documents"
    }
  }
}
