{
  "kind": "collectionType",
  "collectionName": "cases",
  "info": {
    "singularName": "case",
    "pluralName": "cases",
    "displayName": "Family Case",
    "description": "UK Family Court Cases"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "caseNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "court": {
      "type": "string",
      "default": "Family Court"
    },
    "caseType": {
      "type": "string",
      "required": true,
      "default": "Private Law (Child Arrangements)"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Open",
        "Stayed",
        "Concluded"
      ],
      "default": "Open"
    },
    "startedAt": {
      "type": "date",
      "required": true
    },
    "allocatedJudge": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "currentStage": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "childrenInvolved": {
      "type": "integer",
      "default": 0
    },
    "seekingPeerSupport": {
      "type": "boolean",
      "default": false
    },
    "peerSupportNote": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "peerSupportRequestedAt": {
      "type": "datetime"
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "members": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user"
    },
    "parties": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::party.party",
      "mappedBy": "case"
    },
    "hearings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::hearing.hearing",
      "mappedBy": "case"
    },
    "orders": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order.order",
      "mappedBy": "case"
    },
    "documents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::document.document",
      "mappedBy": "case"
    },
    "notes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::case-note.case-note",
      "mappedBy": "case"
    },
    "deadlines": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::document-deadline.document-deadline",
      "mappedBy": "case"
    },
    "invites": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::case-invite.case-invite",
      "mappedBy": "case"
    }
  }
}
