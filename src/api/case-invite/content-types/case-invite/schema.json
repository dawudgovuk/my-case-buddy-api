{
  "kind": "collectionType",
  "collectionName": "case_invites",
  "info": {
    "singularName": "case-invite",
    "pluralName": "case-invites",
    "displayName": "Case Invite",
    "description": "Collaboration invitation tokens for McKenzie Friends, Solicitors, and Barristers"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "token": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "role": {
      "type": "enumeration",
      "enum": [
        "McKenzieFriend",
        "Solicitor",
        "Barrister"
      ],
      "required": true
    },
    "expiresAt": {
      "type": "datetime"
    },
    "usedAt": {
      "type": "datetime"
    },
    "case": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::case.case",
      "inversedBy": "invites"
    },
    "createdBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "usedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
