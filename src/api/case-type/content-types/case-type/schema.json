{
  "kind": "collectionType",
  "collectionName": "case_types",
  "info": {
    "singularName": "case-type",
    "pluralName": "case-types",
    "displayName": "Case Type / Proceedings Track",
    "description": "Dynamic legal case types and proceedings tracks"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "code": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 1
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "stages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::case-stage.case-stage",
      "mappedBy": "caseType"
    }
  }
}
