{
  "kind": "collectionType",
  "collectionName": "guidance_steps",
  "info": {
    "singularName": "guidance-step",
    "pluralName": "guidance-steps",
    "displayName": "Guidance Step",
    "description": "Concrete actionable step in a legal journey"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 1
    },
    "isConditional": {
      "type": "boolean",
      "default": false
    },
    "conditionCriteria": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "category": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "journeys": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::guidance-journey.guidance-journey",
      "mappedBy": "steps"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::guidance-article.guidance-article",
      "inversedBy": "steps"
    }
  }
}
