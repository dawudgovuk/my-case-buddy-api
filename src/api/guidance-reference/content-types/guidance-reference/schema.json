{
  "kind": "collectionType",
  "collectionName": "guidance_references",
  "info": {
    "singularName": "guidance-reference",
    "pluralName": "guidance-references",
    "displayName": "Guidance Reference",
    "description": "Court forms, official tools, and statutory references"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "Form",
        "Document",
        "Web",
        "Video",
        "Case"
      ],
      "default": "Form",
      "required": true
    },
    "keywords": {
      "type": "string"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::guidance-article.guidance-article",
      "mappedBy": "references"
    }
  }
}
